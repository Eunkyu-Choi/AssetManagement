    private static bool IsMyTeamWinner()
    {
        Unit mu1 = new Unit("MU1");
        Unit mu2 = new Unit("MU2");
        Unit mu3 = new Unit("MU3");
        Unit mu4 = new Unit("MU4");
        Unit mu5 = new Unit("MU5");

        Unit eu1 = new Unit("EU1");
        Unit eu2 = new Unit("EU2");
        Unit eu3 = new Unit("EU3");
        Unit eu4 = new Unit("EU4");
        Unit eu5 = new Unit("EU5");

        Group mg = new Group("MyGroup");
        Group eg = new Group("EnemyGroup");

        mg.SetAsChild(mu1);
        mg.SetAsChild(mu2);
        mg.SetAsChild(mu3);
        mg.SetAsChild(mu4);
        mg.SetAsChild(mu5);

        eg.SetAsChild(eu1);
        eg.SetAsChild(eu2);
        eg.SetAsChild(eu3);
        eg.SetAsChild(eu4);
        eg.SetAsChild(eu5);

        Group attacker = eg;
        Group defender = mg;

        while (attacker.Children.Count != 0 && defender.Children.Count != 0)
        {
            (attacker, defender) = (defender, attacker);
            attacker.AttackTo(defender);
        }

        //Console.Write($"{attacker.Name} won\n");

        if (attacker == mg) return true;
        else return false;
    }
