    private static void TestCombat()
    {
        Unit mu1 = new Unit("MU1", 3, 6, 2, 8, 3);
        Unit mu2 = new Unit("MU2", 3, 6, 2, 8, 3);
        Unit mu3 = new Unit("MU3", 3, 6, 2, 8, 3);
        Unit mu4 = new Unit("MU4", 3, 6, 2, 8, 3);
        Unit mu5 = new Unit("MU5", 3, 6, 2, 8, 3);

        Unit eu1 = new Unit("EU1", 3, 6, 2, 8, 3);
        Unit eu2 = new Unit("EU2", 3, 6, 2, 8, 3);
        Unit eu3 = new Unit("EU3", 3, 6, 2, 8, 3);
        Unit eu4 = new Unit("EU4", 3, 6, 2, 8, 3);
        Unit eu5 = new Unit("EU5", 3, 6, 2, 8, 3);

        Group mg = new Group("MyGroup");
        Group eg = new Group("EnemyGroup");

        mg.SetAsChild(mu1);
        mg.SetAsChild(mu2);
        mg.SetAsChild(mu3);
        mg.SetAsChild(mu4);
        mg.SetAsChild(mu5);

        eg.SetAsChild(eu1);
        eg.SetAsChild(eu2);
        eg.SetAsChild(eu3);
        eg.SetAsChild(eu4);
        eg.SetAsChild(eu5);

        Group attacker = mg;
        Group defender = eg;

        float turnCounter = 1;

        Console.WriteLine("Start Combat? Y / N");
        char startCombatInput = Console.ReadKey().KeyChar;

        Console.Clear();
        if (startCombatInput != 'y' && startCombatInput != 'Y') return;

        while (attacker.Children.Count != 0 && defender.Children.Count != 0)
        {
            Console.Write($"\n[{turnCounter} Turn]\n");

            attacker.AttackTo(defender);
            if (defender.Children.Count == 0) break;
            (attacker, defender) = (defender, attacker);

            attacker.AttackTo(defender);
            if (defender.Children.Count == 0) break;
            (attacker, defender) = (defender, attacker);

            turnCounter++;

            Console.WriteLine("Continue To Next Turn? Y / N");
            char continueCombatInput = Console.ReadKey().KeyChar;

            Console.Clear();
            if (continueCombatInput != 'y' && continueCombatInput != 'Y') return;
        }

        Console.Write($"{attacker.Name} won / {turnCounter} turns");
    }
