using System;
using System.Collections.Generic;
using System.Diagnostics.CodeAnalysis;

public class Unit : IChild
{
    public int HierarchyLvl { get; } = 2;
    public int ID { get; private set; }

    // IIdentifiable implementation   
    public string Name { get; private set; }
    public void SetName(string newName) => Name = newName;

    // IChild implementation
    public IParent Parent { get; private set; }
    public void SetParent(IParent newParent) => Parent = newParent;

    public Unit(string unitName, int atkDiceCount, int atkDiceVal, int defDiceCount, int defDiceVal, int life)
    {
        ID = ExtensionMethods.GetValidID();
        Name = unitName;

        ATKDiceCount = atkDiceCount;
        ATKDiceVal = atkDiceVal;
        DEFDiceCount = defDiceCount;
        DEFDiceVal = defDiceVal;
        Life = life;
    }

    public int ATKDiceCount { get; private set; }
    public int ATKDiceVal { get; private set; }
    public int DEFDiceCount { get; private set; }
    public int DEFDiceVal { get; private set; }
    public int Life { get; private set; }
    public void ChangeLife(int newLife) => Life = newLife;
}
